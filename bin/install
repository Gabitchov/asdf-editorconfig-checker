#!/usr/bin/env bash

set -e
set -o pipefail

install_tool() {
	#local install_type=$1
	local version=$2
	local install_path=$3
	local tmp_download_dir=$4

	local major_version="${version%%.*}"
	local platform
	local archive_prefix
	local binary_name
	local alias_name
	local bin_install_path="$install_path/bin"
	local download_url
	local download_path

	# Since v4.0.0 the binary was renamed from ec to editorconfig-checker
	if [ "$major_version" -ge 4 ]; then
		archive_prefix=editorconfig-checker
		binary_name=editorconfig-checker
		alias_name=ec
	else
		archive_prefix=ec
		binary_name=ec
		alias_name=editorconfig-checker
	fi

	platform=$(get_platform "$major_version")
	download_url=$(get_download_url "$version" "$platform" "$archive_prefix")
	download_path="$tmp_download_dir/"$(get_filename "$platform" "$archive_prefix")

	echo "Downloading [${archive_prefix}] from ${download_url} to ${download_path}"
	curl -fLo "$download_path" "$download_url"

	echo "Creating bin directory"
	mkdir -p "${bin_install_path}"

	echo "Cleaning previous binaries"
	rm -f "$bin_install_path/ec" "$bin_install_path/editorconfig-checker" 2>/dev/null || true

	echo "Extracting archive"
	tar xpf "$download_path" -C "$tmp_download_dir"

	echo "Copying binary"
	cp "$(get_binary_path_in_archive "${tmp_download_dir}" "${platform}" "${major_version}")" "$bin_install_path/${binary_name}"
	chmod +x "$bin_install_path/${binary_name}"

	# Provide both names so scripts using either one keep working
	ln -s "${binary_name}" "$bin_install_path/${alias_name}"
}

# < v4: ec-linux-amd64.tar.gz containing bin/ec-linux-amd64
# >= v4: editorconfig-checker-linux-amd64.tar.gz containing editorconfig-checker

get_binary_path_in_archive() {
	local archive_dir=$1
	local platform=$2
	local major_version=$3

	if [ "$major_version" -ge 4 ]; then
		echo "$archive_dir/editorconfig-checker"
	else
		echo "$archive_dir/bin/ec-$platform"
	fi
}

get_platform() {
	local major_version=$1
	local os
	os=$(uname | tr '[:upper:]' '[:lower:]')

	# Since v4.0.0 macOS ships a single universal binary
	if [ "$os" = "darwin" ] && [ "$major_version" -ge 4 ]; then
		echo "darwin-all"
		return
	fi
	echo "${os}-$(get_arch "$major_version")"
}

get_arch() {
	local major_version=$1
	local arch
	arch=$(uname -m)
	case $arch in
	"x86_64" | "amd64")
		echo "amd64"
		;;
	"i386" | "i686")
		echo "386"
		;;
	"arm" | "armv6l" | "armv7l")
		if [ "$major_version" -ge 4 ]; then
			echo "armv6"
		else
			echo "arm"
		fi
		;;
	"aarch64" | "arm64")
		echo "arm64"
		;;
	*)
		exit 1
		;;
	esac

}

get_filename() {
	local platform="$1"
	local archive_prefix="$2"

	echo "${archive_prefix}-${platform}.tar.gz"
}

# https://github.com/editorconfig-checker/editorconfig-checker/releases/download/2.2.2/ec-linux-amd64.tar.gz
# if version is 3.0.0 or higher, use v3.0.0
# https://github.com/editorconfig-checker/editorconfig-checker/releases/download/v3.0.0/ec-linux-amd64.tar.gz
# https://github.com/editorconfig-checker/editorconfig-checker/releases/download/v4.0.0/editorconfig-checker-linux-amd64.tar.gz

get_download_url() {
	local version="$1"
	local platform="$2"
	local archive_prefix="$3"
	local filename
	filename="$(get_filename "$platform" "$archive_prefix")"

	if [ "${version%%.*}" -ge 3 ]; then
		version="v${version}"
	fi
	echo "https://github.com/editorconfig-checker/editorconfig-checker/releases/download/${version}/${filename}"
}

tmp_download_dir="$(mktemp -d -t 'asdf_XXXXXXXX')"
trap 'rm -rf "${tmp_download_dir}"' EXIT
install_tool "$ASDF_INSTALL_TYPE" "$ASDF_INSTALL_VERSION" "$ASDF_INSTALL_PATH" "$tmp_download_dir"
